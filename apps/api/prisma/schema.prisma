generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model cache {
  key        String @id @db.VarChar(255)
  value      String @db.MediumText
  expiration Int
}

model cache_locks {
  key        String @id @db.VarChar(255)
  owner      String @db.VarChar(255)
  expiration Int
}

model failed_jobs {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  uuid       String   @unique(map: "failed_jobs_uuid_unique") @db.VarChar(255)
  connection String   @db.Text
  queue      String   @db.Text
  payload    String   @db.LongText
  exception  String   @db.LongText
  failed_at  DateTime @default(now()) @db.Timestamp(0)
}

model items {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  ItemCode   String    @unique(map: "items_itemcode_unique") @db.VarChar(255)
  ItemName   String    @db.VarChar(255)
  RackNo     String?   @db.VarChar(255)
  Barcode    String?   @db.VarChar(255)
  InvntryUom String?   @db.VarChar(255)
  CardCode   String    @db.VarChar(255)
  CardName   String    @db.VarChar(255)
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
  orders     orders[]
}

model job_batches {
  id             String  @id @db.VarChar(255)
  name           String  @db.VarChar(255)
  total_jobs     Int
  pending_jobs   Int
  failed_jobs    Int
  failed_job_ids String  @db.LongText
  options        String? @db.MediumText
  cancelled_at   Int?
  created_at     Int
  finished_at    Int?
}

model jobs {
  id           BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  queue        String @db.VarChar(255)
  payload      String @db.LongText
  attempts     Int    @db.UnsignedTinyInt
  reserved_at  Int?   @db.UnsignedInt
  available_at Int    @db.UnsignedInt
  created_at   Int    @db.UnsignedInt

  @@index([queue], map: "jobs_queue_index")
}

model migrations {
  id        Int    @id @default(autoincrement()) @db.UnsignedInt
  migration String @db.VarChar(255)
  batch     Int
}

model orders {
  id                BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  DocNum            Int?
  CreateDate        DateTime?           @db.Date
  DocDate           DateTime?           @db.Date
  DocTime           String?             @db.VarChar(255)
  DocDueDate        DateTime?           @db.Date
  UpdateDate        DateTime?           @db.Date
  CardCode          String?             @db.VarChar(255)
  CardName          String?             @db.VarChar(255)
  Address           String?             @db.VarChar(255)
  Phone1            String?             @db.VarChar(255)
  TrnspCode         Int?
  TrnspName         String?             @db.VarChar(255)
  Comments          String?             @db.Text
  SlpCode           Int?
  SlpName           String?             @db.VarChar(255)
  USERID            String?             @db.VarChar(255)
  U_NAME            String?             @db.VarChar(255)
  Memo              String?             @db.VarChar(255)
  LineNum           Int?
  ItemCode          String?             @db.VarChar(255)
  Dscription        String?             @db.VarChar(255)
  ShipDate          DateTime?           @db.Date
  Quantity          Decimal?            @db.Decimal(18, 4)
  OpenQty           Decimal?            @db.Decimal(18, 4)
  DelivrdQty        Decimal?            @db.Decimal(18, 4)
  unitMsr           String?             @db.VarChar(255)
  NumPerMsr         Decimal?            @db.Decimal(18, 4)
  unitMsr2          String?             @db.VarChar(255)
  NumPerMsr2        Decimal?            @db.Decimal(18, 4)
  BuyUnitMsr        String?             @db.VarChar(255)
  SalUnitMsr        String?             @db.VarChar(255)
  NumInSale         Decimal?            @db.Decimal(18, 4)
  NumInBuy          Decimal?            @db.Decimal(18, 4)
  SuppCatNum        String?             @db.VarChar(255)
  Price             Decimal?            @db.Decimal(18, 4)
  OnHand            Decimal?            @db.Decimal(18, 4)
  InvntryUom        String?             @db.VarChar(255)
  OrdrMulti         Decimal?            @db.Decimal(18, 4)
  created_at        DateTime?           @db.Timestamp(0)
  updated_at        DateTime?           @db.Timestamp(0)
  pick_list_details pick_list_details[]
  item              items?              @relation(fields: [ItemCode], references: [ItemCode])
  @@unique([DocNum, LineNum], map: "orders_docnum_linenum_unique")

}

model password_reset_tokens {
  email      String    @id @db.VarChar(255)
  token      String    @db.VarChar(255)
  created_at DateTime? @db.Timestamp(0)
}

model permissions {
  id              BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  name            String            @unique(map: "permissions_name_unique") @db.VarChar(255)
  description     String?           @db.VarChar(255)
  created_at      DateTime?         @db.Timestamp(0)
  updated_at      DateTime?         @db.Timestamp(0)
  role_permission role_permission[]
}

model personal_access_tokens {
  id             BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  tokenable_type String    @db.VarChar(255)
  tokenable_id   BigInt    @db.UnsignedBigInt
  name           String    @db.VarChar(255)
  token          String    @unique(map: "personal_access_tokens_token_unique") @db.VarChar(64)
  abilities      String?   @db.Text
  last_used_at   DateTime? @db.Timestamp(0)
  expires_at     DateTime? @db.Timestamp(0)
  created_at     DateTime? @db.Timestamp(0)
  updated_at     DateTime? @db.Timestamp(0)

  @@index([tokenable_type, tokenable_id], map: "personal_access_tokens_tokenable_type_tokenable_id_index")
}

model pick_list_details {
  id             BigInt                   @id @default(autoincrement()) @db.UnsignedBigInt
  order_id       BigInt                   @db.UnsignedBigInt
  pick_list_id   BigInt                   @db.UnsignedBigInt
  item_code      String                   @db.VarChar(255)
  item_name      String                   @db.VarChar(255)
  buy_unit_msr   String?                  @db.VarChar(255)
  sal_unit_msr   String?                  @db.VarChar(255)
  num_in_sale    Decimal?                 @db.Decimal(18, 4)
  num_in_buy     Decimal?                 @db.Decimal(18, 4)
  demand         Decimal                  @db.Decimal(18, 4)
  picked         Decimal                  @default(0.0000) @db.Decimal(18, 4)
  open_qty       Decimal?                 @db.Decimal(18, 4)
  confirmed_pick Int                      @default(0)
  status         pick_list_details_status @default(open)
  unit           String?                  @db.VarChar(255)
  rack_no        String?                  @db.VarChar(255)
  created_at     DateTime?                @db.Timestamp(0)
  updated_at     DateTime?                @db.Timestamp(0)
  order         orders                   @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "pick_list_details_order_id_foreign")
  pick_lists     pick_lists               @relation(fields: [pick_list_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "pick_list_details_pick_list_id_foreign")

  @@index([order_id], map: "pick_list_details_order_id_foreign")
  @@index([pick_list_id], map: "pick_list_details_pick_list_id_foreign")
}

model pick_lists {
  id                BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  code              String              @unique(map: "pick_lists_code_unique") @db.VarChar(255)
  status            pick_lists_status   @default(open)
  user_id           BigInt              @db.UnsignedBigInt
  start_at          DateTime?           @db.DateTime(0)
  complete_at       DateTime?           @db.DateTime(0)
  notes             String?             @db.Text
  area              String?             @db.VarChar(255)
  printed           Boolean             @default(false)
  printed_at        DateTime?           @db.DateTime(0)
  created_at        DateTime?           @db.Timestamp(0)
  updated_at        DateTime?           @db.Timestamp(0)
  pick_list_details pick_list_details[]
  users             users               @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "pick_lists_user_id_foreign")

  @@index([user_id], map: "pick_lists_user_id_foreign")
}

model role_permission {
  role_id       BigInt      @db.UnsignedBigInt
  permission_id BigInt      @db.UnsignedBigInt
  permissions   permissions @relation(fields: [permission_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "role_permission_permission_id_foreign")
  roles         roles       @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "role_permission_role_id_foreign")

  @@id([role_id, permission_id])
  @@index([permission_id], map: "role_permission_permission_id_foreign")
}

model roles {
  id              BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  role            String            @db.VarChar(255)
  description     String            @db.VarChar(255)
  created_at      DateTime?         @db.Timestamp(0)
  updated_at      DateTime?         @db.Timestamp(0)
  role_permission role_permission[]
  users           users[]
}

model sessions {
  id            String  @id @db.VarChar(255)
  user_id       BigInt? @db.UnsignedBigInt
  ip_address    String? @db.VarChar(45)
  user_agent    String? @db.Text
  payload       String  @db.LongText
  last_activity Int

  @@index([last_activity], map: "sessions_last_activity_index")
  @@index([user_id], map: "sessions_user_id_index")
}

model users {
  id                BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  name              String       @db.VarChar(255)
  email             String       @unique(map: "users_email_unique") @db.VarChar(255)
  username          String       @unique(map: "users_username_unique") @db.VarChar(255)
  role_id           BigInt       @db.UnsignedBigInt
  email_verified_at DateTime?    @db.Timestamp(0)
  password          String       @db.VarChar(255)
  remember_token    String?      @db.VarChar(100)
  created_at        DateTime?    @db.Timestamp(0)
  updated_at        DateTime?    @db.Timestamp(0)
  pick_lists        pick_lists[]
  roles             roles        @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "users_role_id_foreign")

  @@index([role_id], map: "users_role_id_foreign")
}

enum pick_lists_status {
  open
  picking
  picked
}

enum pick_list_details_status {
  open
  incomplete
  complete
}
